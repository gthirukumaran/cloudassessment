# SecurityA Backend Environment Configuration - Local Development

# Application Settings
DEBUG=true
APP_NAME=SecurityA
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Database Configuration - Local PostgreSQL
DATABASE_URL=postgresql://securitya_user:securitya_password@localhost:5439/securitya_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration - Local Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Security Settings
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Azure OAuth2 Configuration (Optional for local dev)
AZURE_CLIENT_ID=b1ea4ce4-a960-4141-ba48-a5480b05edd9
AZURE_CLIENT_SECRET=hkt8Q~C_Tf-.0e8vx-8_fdSNCucX1t~ZHtuXDdAC
AZURE_TENANT_ID=64b85bc1-b5cf-4169-9b23-8addcc72c198
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# OpenAI Configuration (Optional)
OPENAI_API_KEY=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
