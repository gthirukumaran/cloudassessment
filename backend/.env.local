# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3016"]

# Storage Configuration (Local/Mock)
STORAGE_TYPE=local
STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER=securitya-reports
AZURE_STORAGE_CONTAINER=securitya-reports

# Azure Key Vault (Optional)
AZURE_KEY_VAULT_URL=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# Scan Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_MINUTES=30
RETENTION_DAYS=90

# AI Features
AI_ANALYSIS_ENABLED=true
AI_CHAT_ENABLED=true
AI_REPORT_GENERATION_ENABLED=true